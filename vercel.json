{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=14400, s-maxage=14400" }
      ]
    },
    {
      "source": "/resultados/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=14400, s-maxage=14400" }
      ]
    },
    {
      "source": "/institucional/regulamento/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=14400, s-maxage=14400" }
      ]
    }
  ]
}
